# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (Supabase Transaction Pooler — port 6543)
DATABASE_URL=postgres://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Vercel Blob (for image uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# Vercel API (for the deploy-to-Vercel feature)
VERCEL_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=your-team-id  # optional

# App URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# GrapesJS Studio SDK (leave empty for development)
NEXT_PUBLIC_GRAPESJS_LICENSE_KEY=
